API_VERSION=1.0.0

#dev, test, prod
PROFILE=

ACCESS_TOKEN=DFSDFSFDS,EEWWER


#--logging
LOGGING_LEVEL=debug
LOGGING_FILE_NAME=service.log
LOGGING_MAX_SIZE=100
LOGGING_MAX_BACKUPS=10
LOGGING_MAX_AGE=30

#--DB
DB_NAME=
DB_USER=user
DB_PASSWORD=password
DB_HOST=
DB_PORT=3306
# размер пула
DB_MAX_OPEN_CONNS=10
# Максимальное время жизни нити
DB_CONN_MAX_LIFETIME=60s
# максимальное количество нагретых нитей
DB_MAX_IDLE_CONNS=5
#Базовый интервал (в секундах) между попытками переподключения к БД.
DB_RETRY_INTERVAL=2
#максимальное количество попыток переподключения. Если указать 0 то будет бесконечно
DB_MAX_RETRIES=10
#коэффициент роста паузы между повторными попытками. Если 0 то используется фиксированный интервал (всегда DB_RETRY_INTERVAL). float64
DB_BACKOFF_MULTIPLIER=2

#--kafka
#через запятую
KAFKA_BROKERS=kafka-broker1:9092, kafka-broker2:9092, kafka-broker3:9092
NEW_USER_TOPIC=NewUser
DELETED_USER_TOPIC=DeletedUser
UN_BLOCK_USER_TOPIC=UnBlockUser
BLOCK_UNBLOCK_USER_TOPIC=BlockUnBlockUser
AUDIT_TOPIC=Audit
KAFKA_RETRY_ATTEMPTS=5
KAFKA_CONSUMER_GROUP=1
KAFKA_RETRY_INTERVAL_SECONDS=10
KAFKA_SEND_TIMEOUT_SECONDS=20

#--http server
SERVER_PORT=3000

#--redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=penis
REDIS_USER_TTL_HOURS=72
REDIS_IDEMPOTENCY_TTL_HOURS=24